.venv/
/.venv-policy/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Runtime data and local operator state never belong in source control.
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log
.env
.env.*
!.env.example
*.local.yaml
*.local.yml
*.local.json

# Private implementations and machine-local artifacts stay outside public source.
/.local/
/private/
/private_adapters/
/local_adapters/
/adapters/private/
/adapters/local/
/checkpoints/
/trajectories/
/runtime/
/models/artifacts/
/models/checkpoints/
/models/local/
/models/private/

# Public model registry metadata is allowed; model payloads are not.
*.safetensors
*.safetensors.index.json
*.gguf
*.ggml
*.weights
*.ckpt
*.pt
*.pth
*.onnx
*.model
*.bin
*.bin.index.json
*.pkl
*.pickle
*.npy
*.npz
